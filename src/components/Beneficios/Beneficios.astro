---

// Utils
import { Icon } from "astro-icon/components";
import { Picture } from "astro:assets";

// Images
import whatsappIcon from "../../icons/WhatsApp.png";

import { BUSINESS } from "@data/client";


---


<!-- ============================================ -->
<!--                 Side by Side                 -->
<!-- ============================================ -->

<section id="sbs-2316">
    <div class="cs-container">
        <div class="cs-content cs-content1">
            <picture class="cs-picture cs-picture1">
                <img loading="lazy" decoding="async" src="https://images.unsplash.com/photo-1782898622998-899bb7183a12?q=80&w=387&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D" alt="people" width="608" height="406">
            </picture>
            <div class="cs-wrapper cs-wrapper1">
                <span class="cs-topper">Benefícios</span>
                <h2 class="cs-title">Móveis pensados para as necessidades do seu espaço</h2>
                <p class="cs-text">
                    A {BUSINESS.name} trabalha com móveis sob medida, considerando as dimensões do ambiente e as necessidades de uso. Cada projeto começa com a compreensão do que você procura e das possibilidades para o seu espaço.
                </p>
                <ul class="cs-ul">
                    <li class="cs-li"><strong>Móveis sob medida:</strong> Peças dimensionadas para atender às características e necessidades do ambiente.</li>
                    <li class="cs-li"><strong>Funcionalidade no dia a dia:</strong> Configurações que consideram o uso e a organização dos espaços.</li>
                    <li class="cs-li"><strong>Escolhas alinhadas às suas necessidades:</strong> Converse sobre as características do móvel que você procura e avalie as possibilidades.</li>
                    <li class="cs-li"><strong>Cozinhas em MDF:</strong> Uma opção de mobiliário para compor e organizar o ambiente da cozinha.</li>
                </ul>
                <div class="cs-button-box">
                    <a class="cs-link" href={BUSINESS.phoneForTel}>
                        <picture class="cs-icon-wrapper">
                            <img class="cs-icon" loading="lazy" decoding="async" src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/red-phone.svg" alt="icon"
                                width="24" height="24">
                        </picture>
                        <div class="cs-info">
                            <span class="cs-link-content">Ligue Agora!</span>
                            <span class="cs-phone">{BUSINESS.phoneFormatted}</span>
                        </div>
                    </a>
                    <a class="cs-link" href={BUSINESS.whatsAppUrl}>
                        <picture class="cs-img-wrapper">
                            <img class="cs-img" loading="lazy" decoding="async" src={whatsappIcon.src}  alt="whatsapp"
                                width="52" height="52">
                        </picture>
                        <div class="cs-info">
                            <span class="cs-link-content">Mandar Mensagem!</span>
                            <span class="cs-phone">{BUSINESS.whatsApp}</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>
        <div class="cs-content cs-content2">
            <picture class="cs-picture cs-picture2">
                <img loading="lazy" decoding="async" src="https://images.unsplash.com/photo-1639125720149-5640a37f1c4d?q=80&w=1033&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D" alt="people" width="608" height="406">
            </picture>
            <div class="cs-wrapper cs-wrapper2">
                <p class="cs-text">
                    A marcenaria ideal para o seu espaço, com móveis pensados para as suas necessidades e preferências.
                </p>
                <a class="cs-button-solid" href="">Saiba Mais</a>
            </div>
        </div>
    </div>
</section>
                                
                                
<!-- Modificado max-width na .cs-container para var(--containerWidth) -->
<!-- Modificado gap na .cs-container para var(--sectionGap) -->
<!-- Modificado line-height na .cs-li para var(--lineHeightBody) -->
<!-- Modificado background do bullet na .cs-li:before para var(--secondary) -->
<!-- Modificado background-color da .cs-icon-wrapper::before para var(--primary) -->
<!-- Modificado line-height nos textos de info da .cs-link para var(--lineHeightHeading) -->
<!-- Modificado line-height e border-top da .cs-job para var(--lineHeightBody) e var(--borderColor) -->
<!-- Modificado border-radius, background, padding, line-height e font-family da .cs-button-solid para as variáveis de botão -->
<!-- Modificado background-color da .cs-button-solid:before para var(--primaryDark) -->
<!-- Modificado border-radius das imagens .cs-picture img para var(--imageRadius) -->
<style lang="less">

/*-- -------------------------- -->
<---        Side by Side        -->
<--- -------------------------- -*/

/* Mobile - 360px */
@media only screen and (min-width: 0rem) {
  #sbs-2316 {
    padding: var(--sectionPadding);
    position: relative;
  }
  #sbs-2316 .cs-container {
    width: 100%;
    /* changes to 1280px at tablet */
    max-width: 36.5rem;
    margin: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* 48px - 64px */
    gap: var(--sectionGap, clamp(3rem, 10vw, 4rem));
  }
  #sbs-2316 .cs-content {
    /* set text align to center if content needs to be centrally aligned */
    text-align: left;
    width: 100%;
    display: flex;
    flex-direction: column;
    /* aligns content to the left, set to center to centrally align */
    align-items: flex-start;
    /* 48px - 72px */
    gap: clamp(3rem, 7vw, 4.5rem);
  }
  #sbs-2316 .cs-content2 {
    /* 20px - 72px */
    gap: clamp(1.25rem, 7vw, 4.5rem);
  }
  #sbs-2316 .cs-title,
  #sbs-2316 .cs-text {
    max-width: 100%;
  }
  #sbs-2316 .cs-ul {
    margin: 1rem 0 2rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  #sbs-2316 .cs-li {
    font-size: 1rem;
    line-height: var(--lineHeightBody, 1.55);
    list-style: none;
    color: var(--bodyTextColor);
  }
  #sbs-2316 .cs-li:before {
    /* bullet */
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    margin: 0 0.75rem 0.125rem 0.125rem;
    background: var(--secondary, #2C1E16);
    display: inline-block;
    transform: rotate(45deg);
  }
  #sbs-2316 .cs-button-box {
    width: 100%;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 2rem;
    row-gap: 1rem;
  }
  #sbs-2316 .cs-link {
    text-decoration: none;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 1rem;
    position: relative;
  }
  #sbs-2316 .cs-icon-wrapper {
    width: 3.75rem;
    height: 3.75rem;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    transition: transform 0.3s;
    /* prevents flexbox from squishing it */
    flex: none;
  }
  #sbs-2316 .cs-icon-wrapper::before {
    content: "";
    width: 100%;
    height: 100%;
    background-color: var(--primary, #A36626);
    opacity: 0.1;
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    border-radius: var(--radius-xs, 0.125rem);
  }
  #sbs-2316 .cs-icon {
    width: 1.5rem;
    height: auto;
    display: block;
  }
  #sbs-2316 .cs-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }
  #sbs-2316 .cs-link-content {
    font-size: 1rem;
    font-weight: 400;
    line-height: var(--lineHeightHeading, 1.2);
    margin: 0;
    color: var(--bodyTextColor);
    display: block;
  }
  #sbs-2316 .cs-phone {
    font-size: 1.5625rem;
    font-weight: 700;
    line-height: var(--lineHeightHeading, 1.2);
    margin: 0;
    color: var(--headerColor);
    display: block;
  }
  #sbs-2316 .cs-img {
    width: 3.75rem;
    height: auto;
     object-fit: contain;
  }
  #sbs-2316 .cs-signature {
    width: auto;
    height: 2.25rem;
    /* centers the signature while everything else remains aligned to the left */
    margin: 0 auto;
    display: block;
  }
  #sbs-2316 .cs-job {
    font-size: 1rem;
    line-height: var(--lineHeightBody, 1.55);
    text-align: center;
    margin-top: 0.375rem;
    padding-top: 0.25rem;
    color: var(--bodyTextColor);
    border-top: 1px solid var(--borderColor, rgba(35, 24, 18, 0.12));
  }
  #sbs-2316 .cs-button-solid {
    font-family: 'Urbanist', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    /* 46px - 56px */
    line-height: clamp(2.875rem, 5.5vw, 3.5rem);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    min-width: 9.375rem;
    margin: 2rem 0 0;
    /* prevents padding from adding to the width */
    box-sizing: border-box;
    padding: var(--buttonPadding, 0 2rem);
    background-color: var(--buttonPrimaryBg, var(--primary, #A36626));
    color: var(--buttonPrimaryText, #FFFFFF);
    border-radius: var(--buttonRadius, 0.125rem);
    display: inline-block;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }
  #sbs-2316 .cs-button-solid:before {
    content: "";
    width: 0%;
    height: 100%;
    background-color: var(--primaryDark, #6E4114);
    opacity: 1;
    border-radius: var(--buttonRadius, 0.125rem);
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    transition: width 0.3s ease-in-out;
  }
  #sbs-2316 .cs-button-solid:hover:before {
    width: 100%;
  }
  #sbs-2316 .cs-picture {
    display: block;
    position: relative;
    z-index: 1;
  }
  #sbs-2316 .cs-picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    border-radius: var(--imageRadius, 0.25rem);
  }
  #sbs-2316 .cs-picture1 {
    width: 100%;
    /* 280px - 400px */
    height: clamp(17.5rem, 55vw, 25rem);
  }
  #sbs-2316 .cs-picture2 {
    width: 100%;
    height: 17.5rem;
  }
}
/* Desktop - 1024px */
@media only screen and (min-width: 64rem) {
  #sbs-2316 .cs-container {
    max-width: var(--containerWidth, 78rem);
    flex-direction: column;
    justify-content: space-between;
    align-items: stretch;
  }
  #sbs-2316 .cs-content {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
  }
  #sbs-2316 .cs-content2 {
    flex-direction: row-reverse;
    justify-content: space-between;
  }
  #sbs-2316 .cs-wrapper {
    width: 100%;
    max-width: 49.6875rem;
  }
  #sbs-2316 .cs-wrapper2 {
    max-width: 25.8125rem;
    padding-bottom: 7.5rem;
  }
  #sbs-2316 .cs-picture1 {
    max-width: 25.75rem;
    height: auto;
  }
  #sbs-2316 .cs-picture2 {
    width: 64vw;
    max-width: 49.6875rem;
    height: auto;
    flex: none;
  }
}
/* Large Desktop - 1300px */
@media only screen and (min-width: 81.25rem) {
  #sbs-2316 .cs-wrapper {
    padding-right: 4.5rem;
  }
}

</style>

<!-- Dark css -->
 <style lang="less">

</style>
