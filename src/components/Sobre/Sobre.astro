---

// Utils
import { Icon } from "astro-icon/components";
import { Picture } from "astro:assets";

// Images

import { BUSINESS } from "@data/client";

---


<!-- ============================================ -->
<!--                Sobre                  -->
<!-- ============================================ -->
<section id="why-choose-1631">
    <div class="cs-container">
        <div class="cs-flex">
            <picture class="cs-picture">
                <img loading="lazy" decoding="async" 
                src="https://images.unsplash.com/photo-1611021061218-761c355ed331?q=80&w=870&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D" alt="therapy" width="608" height="400">
            </picture>
            <div class="cs-content">
                <span class="cs-topper">Sobre a {BUSINESS.name}</span>
                <h2 class="cs-title">Conheça a {BUSINESS.name} e seu trabalho com móveis sob medida!</h2>
                <p class="cs-text">
                    Para diferentes necessidades e espaços. Uma marcenaria para quem busca mobiliário adequado às características do ambiente e ao uso do dia a dia.
            </div>
        </div>
        <ul class="cs-card-group">
            <li class="cs-item">
                <h3 class="cs-h3">
                    <picture class="cs-wrapper">
                        <img class="cs-h3-icon" aria-hidden="true" loading="lazy" decoding="async" src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/chat-gold.svg" alt="icon" width="24" height="24">
                    </picture>
                    Conte-nos o que você precisa
                </h3>
                <p class="cs-item-text">
                    Explique qual móvel procura e quais são as necessidades do seu ambiente para iniciar uma conversa sobre as possibilidades.
                </p>
            </li>
            <li class="cs-item">
                <h3 class="cs-h3">
                    <picture class="cs-wrapper">
                        <img class="cs-h3-icon" aria-hidden="true" loading="lazy" decoding="async" src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/call-gold.svg" alt="icon" width="24" height="24">
                    </picture>
                    Entre em contato
                </h3>
                <p class="cs-item-text">
                    Converse com a {BUSINESS.name} para apresentar sua ideia e conhecer as possibilidades de atendimento.
                </p>
            </li>
            <li class="cs-item">
                <h3 class="cs-h3">
                    <picture class="cs-wrapper">
                        <img class="cs-h3-icon" aria-hidden="true" loading="lazy" decoding="async" src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/money-gold.svg"
                         alt="icon" width="24" height="24">
                    </picture>
                    Móveis para o seu espaço
                </h3>
                <p class="cs-item-text">
                    Conheça as opções de marcenaria e móveis sob medida disponíveis para o seu ambiente.
                </p>
            </li>
        </ul>
    </div>
</section>



<!-- Modificado max-width da .cs-container para var(--containerWidth) -->
<!-- Modificado gap da .cs-container e .cs-flex para var(--sectionGap) -->
<!-- Modificado border-radius de imagem da .cs-picture para var(--imageRadius) -->
<!-- Modificado line-height nos títulos .cs-h3 para var(--lineHeightHeading) -->
<!-- Modificado border-color e border-radius da .cs-wrapper para var(--primary) e var(--radius-xs) -->
<!-- Modificado line-height do texto .cs-item-text para var(--lineHeightBody) -->
<style lang="less">

/*-- -------------------------- -->
<---         Why Choose Us      -->
<--- -------------------------- -*/

/* Mobile - 360px */
@media only screen and (min-width: 0rem) {
  #why-choose-1631 {
    padding: var(--sectionPadding);
  }
  #why-choose-1631 .cs-container {
    width: 100%;
    /* changes to 1280px at desktop */
    max-width: 34.375rem;
    margin: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* 48px - 64px */
    gap: var(--sectionGap, clamp(3rem, 7vw, 4rem));
  }
  #why-choose-1631 .cs-flex {
    width: 100%;
    margin: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* 48px - 64px */
    gap: var(--sectionGap, clamp(3rem, 7vw, 4rem));
  }
  #why-choose-1631 .cs-content {
    /* set text align to left if content needs to be left aligned */
    text-align: left;
    width: 100%;
    max-width: 38rem;
    /* prevents padding from affecting width and height */
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    /* centers content horizontally, set to flex-start to left align */
    align-items: flex-start;
  }
  #why-choose-1631 .cs-text {
    margin-bottom: 1rem;
  }
  #why-choose-1631 .cs-text:last-of-type {
    margin-bottom: 0rem;
  }
  #why-choose-1631 .cs-picture {
    display: block;
    position: relative;
    width: 100%;
    max-width: 39.375rem;
    /* chnages to auto at tablet */
    height: 50vw;
    /* removed at tablet */
    max-height: 25rem;
    /* clips img tag corners */
    overflow: hidden;
    border-radius: var(--imageRadius, 0.25rem);
    /* sends it to the 2nd posiiton in the bottom */
    order: 2;
  }
  #why-choose-1631 .cs-picture img {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
  #why-choose-1631 .cs-card-group {
    width: 100%;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: stretch;
    /* 16px - 20px */
    column-gap: clamp(1rem, 2.5vw, 2rem);
    row-gap: 1.75rem;
  }
  #why-choose-1631 .cs-item {
    list-style: none;
    display: flex;
    grid-column: span 12;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  #why-choose-1631 .cs-h3 {
    /* 20px - 25px */
    font-size: clamp(1.25rem, 3vw, 1.5625rem);
    line-height: var(--lineHeightHeading, 1.2);
    font-weight: 700;
    margin: 0;
    color: var(--headerColor);
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 0.75rem;
    transition: color 0.3s;
  }
  #why-choose-1631 .cs-wrapper {
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--primary, #A36626);
    border-radius: var(--radius-xs, 0.125rem);
    display: flex;
    justify-content: center;
    align-items: center;
  }
  #why-choose-1631 .cs-h3-icon {
    width: 1.5rem;
    height: auto;
    margin-top: 2px;
    display: block;
  }
  #why-choose-1631 .cs-item-text {
    /* 14px - 16px */
    font-size: clamp(0.875rem, 1.5vw, 1rem);
    line-height: var(--lineHeightBody, 1.55);
    margin: 0;
    color: var(--bodyTextColor);
    transition: color 0.3s,
                opacity 0.3s;
  }
}
/* Tablet - 768px */
@media only screen and (min-width: 48rem) {
  #why-choose-1631 .cs-container {
    max-width: var(--containerWidth, 78rem);
  }
  #why-choose-1631 .cs-flex {
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
  }
  #why-choose-1631 .cs-content {
    width: 50%;
    /* 32px - 56px top and bottom */
    padding: clamp(2rem, 4vw, 3.5rem) 0;
    align-self: center;
    flex: none;
  }
  #why-choose-1631 .cs-picture {
    width: 47vw;
    min-height: 25rem;
    max-height: 100%;
    height: auto;
    /* sends it to the left in the 1st position */
    order: -1;
    position: relative;
  }
  #why-choose-1631 .cs-item {
    grid-column: span 4;
  }
}

</style>

