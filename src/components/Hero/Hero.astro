---
/**
 * * The hero component used on the homepage
 * * Takes an image as a prop
 */

// Utils
import { Icon } from "astro-icon/components";
import { Picture } from "astro:assets";
import type { GetImageResult } from "astro";

//dados
import { CONTENT } from "@data/client";

import heroImage from "@assets/images/hero/hero.jpg";


---


<!-- ============================================ -->
<!--                    Hero                      -->
<!-- ============================================ -->

<section id="hero-1059">
    <div class="cs-container">
        <div class="cs-content">
            <span class="cs-topper">Marcenaria em {CONTENT.badge_hero}</span>
            <h1 class="cs-title">{CONTENT.titulo_hero}</h1>
            <p class="cs-text">
                {CONTENT.subtitle_hero}
            </p>
            <a href="" class="cs-button cs-button-custom">Orçamento</a>
        </div>
    </div>



    <!-- Background Image -->
    <Picture
        src={heroImage}
        alt="Cozinha planejada"
        formats={["avif", "webp"]}
        widths={[640, 1280, 1920]}
        sizes="100vw"
        priority
        pictureAttributes={{ class: "cs-background" }}
        />

</section>
                                
                                
                                
<!-- light mode -->
<!-- --backgroundDark: cor do overlay sobre a imagem. -->
<!-- --headerFontSize: tamanho do titulo principal. -->
<!-- --lineHeightHeading: altura da linha do titulo. -->
<!-- --bodyTextColorWhite: textos claros do hero. -->
<!-- --secondaryDark: fundo do botao ao passar o mouse. -->
<style lang="less">
   
/*-- -------------------------- -->
<---           Hero             -->
<--- -------------------------- -*/

/* Mobile - 360px */
@media only screen and (min-width: 0rem) {
    #hero-1059 .cs-topper {
        color: var(--bodyTextColorWhite);
        z-index: 100;
    }


    #hero-1059 {
        /* Centers button */
        text-align: left;
        /* 200px - 300px - leaving extra space for the navigation */
        padding: clamp(12.5rem, 31.95vw, 18.75rem) 1rem 0;
        /* 130px - 200px */
        padding-bottom: clamp(8.125rem, 16.5vw, 12.5rem);
        position: relative;
        z-index: 1;
    }
    #hero-1059 .cs-background {
        width: 100%;
        height: 100%;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: -2;
    }
    #hero-1059 .cs-background:before {
        /* Overlay */
        content: "";
        width: 100%;
        height: 100%;
        background: var(--backgroundDark);
        opacity: 0.84;
        position: absolute;
        display: block;
        top: 0;
        left: 0;
        z-index: 1;
        /* prevents the cursor from interacting with it */
        pointer-events: none;
    }
    #hero-1059 .cs-background img {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        object-fit: cover;
        /* makes the top of the image start at the top of the parent */
        object-position: top;
    }
    #hero-1059 .cs-container {
        width: 100%;
        max-width: 80rem;
        margin: auto;
    }
    #hero-1059 .cs-content {
        /* set text align to left if content needs to be left aligned */
        text-align: center;
        width: 100%;
        max-width: 39.375rem;
        display: flex;
        flex-direction: column;
        /* centers content horizontally, set to flex-start to left align */
        align-items: center;
    }
    #hero-1059 .cs-title {
        /* 39px - 61px */
        font-size: var(--headerFontSize);
        font-weight: 700;
        line-height: var(--lineHeightHeading);
        text-align: inherit;
        max-width: 51.8125rem;
        margin: 0 auto 1rem 0;
        color: var(--bodyTextColorWhite);
        position: relative;
    }
    #hero-1059 .cs-text {
        /* 16px - 20px */
        font-size: clamp(1rem, 1.95vw, 1.25rem);
        line-height: 1.5em;
        text-align: inherit;
        width: 100%;
        /* 464px - 622px */
        max-width: clamp(29rem, 60vw, 38.785rem);
        margin: 0 0 2.5rem 0;
        color: var(--bodyTextColorWhite);
    }
    #hero-1059 .cs-button-solid {
        font-size: 1rem;
        /* 46px - 56px */
        line-height: clamp(2.875rem, 5.5vw, 3.5rem);
        text-decoration: none;
        font-weight: 700;
        margin: 0;
        color: var(--bodyTextColorWhite);
        padding: 0 1.5rem;
        background-color: var(--primary);
        display: inline-block;
        position: relative;
        z-index: 1;
    }
    #hero-1059 .cs-button-solid:before {
        content: "";
        position: absolute;
        display: block;
        height: 100%;
        width: 0%;
        background: var(--secondaryDark);
        opacity: 1;
        top: 0;
        left: 0;
        z-index: -1;
        transition: width 0.3s;
    }
    #hero-1059 .cs-button-solid:hover:before {
        width: 100%;
    }
}
/* Tablet - 768px */
@media only screen and (min-width: 48rem) {
      #hero-1059 .cs-topper {
        color: var(--bodyTextColorWhite);
        z-index: 100;
    }


    #hero-1059 .cs-content {
        text-align: left;
        align-items: flex-start;
    }
    #hero-1059 .cs-background:before {
        background: linear-gradient(
            to right,
            rgba(0, 0, 0, 0.94) 0%,
            rgba(0, 0, 0, 0.94) 2%,
            rgba(0, 0, 0, 0) 100%
        );
        opacity: 1;
    }
}

                                                             
                                

</style>

<!-- dark mode -->
<style lang="less"> 

</style>
