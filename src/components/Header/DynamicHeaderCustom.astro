---
import { isCurrentPage, getDropdownId } from "@js/utils.js";
import DarkModeToggle from "@components/DarkModeToggle/DarkModeToggle.astro";
import navData from "@data/navData.json";

//logo
import { Picture } from "astro:assets";
import logo from "@assets/images/logos/logo-1.png";

---

<!-- ============================================ -->
<!--                HTML / Astro                  -->
<!-- ============================================ -->
<header id="cs-navigation">

   <!--Nav Logo-->
    <a
    href="/"
    class="cs-logo"
    aria-label="Voltar para a página inicial da Empresa"
  >
    <img
      src={logo.src}
      alt=""
      width="270"
      height="29"
      decoding="async"
    />
  </a>

  <nav class="cs-nav" aria-label="main navigation">
    <button class="cs-toggle" id="cs-toggle" type="button" aria-label="mobile menu toggle" aria-expanded="false" aria-controls="cs-ul-wrapper">
      <span class="cs-box" aria-hidden="true">
        <span class="cs-line cs-line1"></span>
        <span class="cs-line cs-line2"></span>
        <span class="cs-line cs-line3"></span>
      </span>
    </button>
    <div class="cs-ul-wrapper" id="cs-ul-wrapper">
      <ul id="cs-expanded" class="cs-ul">
        {navData.map((entry) => (
          <li class:list={["cs-li", { "cs-dropdown": entry.children?.length > 0 }]}>
            {entry.children?.length > 0 ? (
              <>
                <button id={getDropdownId(entry.key)} class:list={["cs-li-link", "cs-dropdown-toggle", { "cs-active": Astro.url.pathname.startsWith(entry.url) }]} type="button" aria-expanded="false" aria-controls={`${getDropdownId(entry.key)}-menu`} aria-haspopup="true">
                  {entry.key}
                  <img class="cs-drop-icon" src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Icons/down-gold.svg" alt="" width="15" height="15" decoding="async" aria-hidden="true">
                </button>
                <ul class="cs-drop-ul" id={`${getDropdownId(entry.key)}-menu`} aria-labelledby={getDropdownId(entry.key)}>
                  {entry.children.map((child) => (
                    <li class="cs-drop-li">
                      <a href={child.url} class:list={["cs-li-link", "cs-drop-link", { "cs-active": isCurrentPage(Astro.url.pathname, child.url) }]} aria-current={isCurrentPage(Astro.url.pathname, child.url)}>{child.key}</a>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <a href={entry.url} class:list={["cs-li-link", { "cs-active": isCurrentPage(Astro.url.pathname, entry.url) }]} aria-current={isCurrentPage(Astro.url.pathname, entry.url)}>{entry.key}</a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </nav>
  <a href="/contact/" class="cs-button-outline">Orçamento</a>
</header>

<!-- ============================================ -->
<!--        Estilos base / light mode              -->
<!-- ============================================ -->
<style lang="less" is:global>
  /* Mobile Navigation */
  @media only screen and (max-width: 1023.5px) {
    body.cs-open { overflow: hidden; }
    #cs-navigation {
      width: 91%;
      max-width: 80rem;
      box-sizing: border-box;
      padding: clamp(0.75rem, 2vw, 1.5rem);
      border-radius: var(--cardRadius);
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 1.5rem;
      position: fixed;
      top: 1.25rem;
      left: 50%;
      z-index: 10000;
      transform: translateX(-50%);
      transition: top .3s, border-radius .3s, width .3s, max-width .3s;
    }
    #cs-navigation:before,
    #cs-navigation:after {
      content: "";
      width: 100%;
      height: 100%;
      border-radius: var(--cardRadius);
      display: block;
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      transition: transform .2s, border-radius .3s, opacity .3s;
    }
    #cs-navigation:before { background: var(--secondary); }
    #cs-navigation:after { background: var(--dark); opacity: 0; z-index: -1; }
    #cs-navigation.scroll-down:not(.cs-active):before { opacity: .75; }
    #cs-navigation.cs-active:before,
    #cs-navigation.cs-active:after { transform: translateX(-50%) scale(1.03); }
    #cs-navigation.cs-active .cs-toggle { transform: rotate(180deg); }
    #cs-navigation.cs-active .cs-ul-wrapper { opacity: 1; transform: scaleY(1); transition-delay: .15s; }
    #cs-navigation.cs-active .cs-li { opacity: 1; transform: translateY(0); }
    #cs-navigation .cs-logo {
      background-color: #fff;
      width: clamp(7rem, 34vw, 9rem);
      max-width: 9rem;
      min-width: 0;
      height: auto;
      margin: 0 auto 0 0;
      padding: .35rem .5rem;
      box-sizing: border-box;
      border-radius: .5rem;
      display: flex;
      align-items: center;
      z-index: 10;
    }
    #cs-navigation .cs-logo img { display: block; width: 100%; height: auto; object-fit: contain; }
    #cs-navigation .cs-nav { order: 3; }
    #cs-navigation .cs-toggle {
      width: 3.5rem;
      height: 3.5rem;
      margin: 0 0 0 auto;
      background-color: var(--primary);
      border: none;
      border-radius: var(--radius-lg);
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
      z-index: 10;
      transition: transform .6s;
    }
    #cs-navigation .cs-box { width: clamp(1.5rem, 2vw, 1.75rem); height: 1rem; position: relative; }
    #cs-navigation .cs-line {
      width: 100%;
      height: 2px;
      background-color: var(--bodyTextColorWhite);
      border-radius: var(--radius-pill);
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }
    #cs-navigation .cs-line1 { top: 0; transition: transform .5s, top .3s; }
    #cs-navigation .cs-line2 { top: 50%; transform: translate(-50%, -50%); transition: transform .5s, top .3s; }
    #cs-navigation .cs-line3 { width: 66%; bottom: 0; left: 0; transform: none; transition: bottom .3s, opacity .3s; }
    #cs-navigation .cs-active .cs-line1 { top: 50%; transform: translate(-50%, -50%) rotate(225deg); }
    #cs-navigation .cs-active .cs-line2 { transform: translate(-50%, -50%) rotate(-225deg); }
    #cs-navigation .cs-active .cs-line3 { opacity: 0; bottom: 100%; }
    #cs-navigation .cs-button-outline { display: none; }
  }
  @media only screen and (min-width: 40.625rem) and (max-width: 1023.5px) {
    #cs-navigation .cs-button-outline {
      font-size: 1rem;
      font-weight: 700;
      line-height: 1em;
      text-align: center;
      text-decoration: none;
      padding: 1rem 1.75rem;
      color: var(--bodyTextColorWhite);
      border: 1px solid #fff;
      border-radius: var(--radius-pill);
      display: block;
      z-index: 1;
    }
  }

  /* Mobile Navigation Menu */
  @media only screen and (max-width: 1023.5px) {
    #cs-navigation .cs-ul-wrapper {
      width: 100%;
      height: auto;
      padding-bottom: 2.4em;
      background-color: var(--secondary);
      overflow: hidden;
      border-radius: 0 0 1.5rem 1.5rem;
      position: absolute;
      top: 85%;
      left: 0;
      z-index: -1;
      transform: scaleY(0);
      transform-origin: top;
      transition: transform .4s;
    }
    #cs-navigation .cs-ul {
      width: 100%;
      max-height: 65vh;
      margin: 0;
      padding: 4rem 0 0;
      overflow: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
    }
    #cs-navigation .cs-li {
      width: 100%;
      margin: 0;
      list-style: none;
      text-align: center;
      opacity: 0;
      transform: translateY(-4.375rem);
      transition: transform .6s, opacity .9s;
    }
    #cs-navigation .cs-li-link {
      font-size: clamp(1rem, 2.5vw, 1.5rem);
      line-height: 1.2em;
      text-decoration: none;
      margin: 0;
      color: var(--bodyTextColorWhite);
      display: inline-block;
      position: relative;
    }
    #cs-navigation .cs-li-link.cs-active,
    #cs-navigation .cs-li-link:hover { color: var(--primary); }
  }

  /* Navigation Dropdown: mobile structure and light colors */
  @media only screen and (max-width: 1023.5px) {
    #cs-navigation .cs-dropdown { width: 70%; max-width: 31.25rem; position: relative; }
    #cs-navigation .cs-dropdown.cs-active .cs-drop-ul {
      height: auto;
      margin: .75rem 0 0;
      padding: .75rem 0;
      opacity: 1;
      visibility: visible;
    }
    #cs-navigation .cs-dropdown.cs-active .cs-drop-link { opacity: 1; }
    #cs-navigation .cs-dropdown .cs-li-link { position: relative; transition: opacity .3s; }
    #cs-navigation .cs-drop-icon {
      width: .9375rem;
      height: auto;
      position: absolute;
      top: 50%;
      right: -1.25rem;
      transform: translateY(-50%);
    }
    #cs-navigation .cs-drop-ul {
      width: 100%;
      height: 0;
      margin: 0;
      padding: 0;
      background-color: var(--primary);
      border-radius: 1rem;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: .75rem;
      transition: padding .3s, margin .3s, height .3s, opacity .3s, visibility .3s;
    }
    #cs-navigation .cs-drop-li { list-style: none; }
    #cs-navigation .cs-li-link.cs-drop-link { font-size: clamp(.875rem, 2vw, 1.25rem); color: var(--bodyTextColorWhite); }
  }

  /* Navigation Dropdown: desktop structure and light colors */
  @media only screen and (min-width: 64rem) {
    #cs-navigation .cs-dropdown { position: relative; }
    #cs-navigation .cs-dropdown:hover { cursor: pointer; }
    #cs-navigation .cs-dropdown:hover .cs-drop-ul,
    #cs-navigation .cs-dropdown.cs-active .cs-drop-ul,
    #cs-navigation .cs-dropdown:focus-within .cs-drop-ul {
      transform: scaleY(1);
      opacity: 1;
      visibility: visible;
    }
    #cs-navigation .cs-dropdown:hover .cs-drop-li,
    #cs-navigation .cs-dropdown.cs-active .cs-drop-li,
    #cs-navigation .cs-dropdown:focus-within .cs-drop-li { opacity: 1; transform: translateY(0); }
    #cs-navigation .cs-drop-icon { width: .9375rem; height: auto; display: inline-block; }
    #cs-navigation .cs-drop-ul {
      min-width: 12.5rem;
      margin: 0;
      padding: 0;
      background-color: var(--secondary);
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      box-shadow: rgba(149, 157, 165, .2) 0 10px 16px;
      border-bottom: 5px solid var(--primary);
      border-radius: 0 0 1rem 1rem;
      position: absolute;
      top: 100%;
      z-index: -100;
      transform: scaleY(0);
      transform-origin: top;
      transition: transform .3s, visibility .3s, opacity .3s;
    }
    #cs-navigation .cs-drop-li {
      list-style: none;
      width: 100%;
      height: auto;
      opacity: 0;
      display: block;
      transform: translateY(-.625rem);
      transition: opacity .6s, transform .6s;
    }
    #cs-navigation .cs-li-link.cs-drop-link {
      font-size: 1rem;
      white-space: nowrap;
      line-height: 1.5em;
      text-decoration: none;
      width: 100%;
      padding: .75rem;
      box-sizing: border-box;
      color: var(--bodyTextColorWhite);
      display: block;
      transition: color .3s, background-color .3s;
    }
    #cs-navigation .cs-li-link.cs-drop-link:hover { background-color: var(--primary); color: #1a1a1a; }
  }
  #cs-navigation .cs-dropdown-toggle { padding: 0; background: transparent; border: 0; font: inherit; cursor: pointer; }
  #cs-navigation .cs-dropdown-toggle:focus-visible,
  #cs-navigation .cs-drop-link:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }

  /* Desktop Navigation */
  @media only screen and (min-width: 64rem) {
    #cs-navigation {
      width: 91%;
      max-width: 90rem;
      height: 5.5rem;
      box-sizing: border-box;
      padding: 1rem 1.5rem;
      background-color: var(--secondary);
      border-radius: var(--cardRadius);
      display: flex;
      align-items: center;
      gap: 1.5rem;
      position: fixed;
      top: 2rem;
      left: 50%;
      z-index: 10000;
      transform: translateX(-50%);
      transition: top .3s, border-radius .3s, width .3s, max-width .3s, background-color .3s;
    }
    #cs-navigation.scroll { width: 100%; max-width: 100%; border-radius: 0; top: 0; }
    #cs-navigation.scroll-down { background-color: color-mix(in srgb, var(--secondary) 85%, transparent); }
    #cs-navigation .cs-toggle { display: none; }
    #cs-navigation .cs-logo {
      background-color: #fff;
      border-radius: var(--cardRadius);
      width: 14.4%;
      max-width: 18.5625rem;
      height: 4.125rem;
      margin: 0 auto 0 0;
      padding: 0;
      display: flex;
      align-items: center;
      z-index: 100;
    }
    #cs-navigation .cs-logo img { width: 100%; height: 100%; object-fit: contain; }
    #cs-navigation .cs-ul-wrapper {
      height: 100%;
      display: flex;
      align-items: center;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
    #cs-navigation .cs-ul {
      width: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      display: flex;
      align-items: center;
      gap: clamp(1.25rem, 2.6vw, 2.25rem);
    }
    #cs-navigation .cs-li { list-style: none; height: 100%; padding: 0; display: flex; align-items: center; flex: none; }
    #cs-navigation .cs-li-link {
      font-size: 1rem;
      line-height: 1.5em;
      text-decoration: none;
      margin: 0;
      color: var(--bodyTextColorWhite);
      display: block;
      position: relative;
      transition: color .3s;
    }
    #cs-navigation .cs-li-link:hover,
    #cs-navigation .cs-li-link.cs-active { color: var(--primary); }
    #cs-navigation .cs-button-outline {
      font-size: 1rem;
      font-weight: 700;
      line-height: 1em;
      text-align: center;
      text-decoration: none;
      padding: 1rem 1.75rem;
      color: var(--bodyTextColorWhite);
      border: 1px solid #fff;
      border-radius: var(--radius-pill);
      display: block;
      z-index: 1;
      transition: background-color .3s, color .3s;
    }
    #cs-navigation .cs-button-outline:hover { background-color: var(--bodyTextColorWhite); color: var(--headerColor); }
  }

  /* DarkModeToggle: base layout */
  @media only screen and (min-width: 0rem) {
    #dark-mode-toggle {
      width: 3rem;
      height: 3rem;
      margin: 0 0 0 auto;
      padding: 0;
      background: transparent;
      overflow: hidden;
      border: none;
      display: block;
      order: 2;
      position: relative;
      z-index: 1000;
    }
    #dark-mode-toggle img,
    #dark-mode-toggle svg {
      width: 1.25rem;
      height: 1.25rem;
      pointer-events: none;
      fill: var(--bodyTextColorWhite);
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
    #dark-mode-toggle .cs-moon { z-index: 2; transition: transform .3s, opacity .3s; }
    #dark-mode-toggle .cs-sun { opacity: 0; z-index: 1; transform: translate(-50%, 100%); transition: transform .3s, opacity .3s; }
  }
  @media only screen and (min-width: 64rem) {
    #dark-mode-toggle { margin: 0; position: relative; top: auto; right: auto; transform: none; }
    #dark-mode-toggle:hover { cursor: pointer; }
  }
</style>

<!-- ============================================ -->
<!--       Estilos exclusivos do dark mode        -->
<!-- ============================================ -->
<style lang="less" is:global>
   /* DarkModeToggle: dark states */
  body.dark-mode #dark-mode-toggle .cs-sun { opacity: 1; transform: translate(-50%, -50%); }
  body.dark-mode #dark-mode-toggle .cs-moon { opacity: 0; transform: translate(-50%, -150%); }

  /* Mobile Navigation: dark colors */
  @media only screen and (max-width: 1023.5px) {
    body.dark-mode #cs-navigation { background-color: var(--dark); }
    body.dark-mode #cs-navigation:before { background-color: #000; opacity: .6; }
    body.dark-mode #cs-navigation:after { opacity: 1; }
    body.dark-mode #cs-navigation.scroll-down { background-color: transparent; }
    body.dark-mode #cs-navigation.scroll-down:before { opacity: 0; }
    body.dark-mode #cs-navigation.scroll-down:not(.cs-active):after { opacity: .75; }
    body.dark-mode #cs-navigation .cs-logo { filter: grayscale(1) brightness(1000%); }
    body.dark-mode #cs-navigation .cs-toggle { background-color: var(--primary); }
    body.dark-mode #cs-navigation .cs-line { background-color: var(--bodyTextColorWhite); }
    body.dark-mode #cs-navigation .cs-ul-wrapper { background-color: var(--dark); }
    body.dark-mode #cs-navigation .cs-ul-wrapper:before {
      content: "";
      width: 100%;
      height: 100%;
      background: #000;
      opacity: .6;
      border-radius: var(--cardRadius);
      display: block;
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      transition: transform .2s, border-radius .5s;
    }
    body.dark-mode #cs-navigation .cs-li-link { color: var(--bodyTextColorWhite); }
  }

  /* Navigation Dropdown: dark colors */
  @media only screen and (max-width: 1023.5px) {
    body.dark-mode #cs-navigation .cs-drop-ul { background-color: var(--dark); }
    body.dark-mode #cs-navigation .cs-drop-link { color: var(--bodyTextColorWhite); }
  }
  @media only screen and (min-width: 64rem) {
    body.dark-mode #cs-navigation .cs-drop-ul { background-color: var(--dark); }
    body.dark-mode #cs-navigation .cs-drop-link:hover { background-color: var(--medium); color: var(--bodyTextColorWhite); }
  }

  /* Desktop Navigation: dark colors */
  @media only screen and (min-width: 64rem) {
    body.dark-mode #cs-navigation { background-color: var(--dark); }
    body.dark-mode #cs-navigation.scroll-down { background-color: color-mix(in srgb, var(--dark) 75%, transparent); }
    body.dark-mode #cs-navigation:before {
      content: "";
      width: 100%;
      height: 100%;
      border-radius: var(--cardRadius);
      background: #000;
      opacity: .6;
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      z-index: -1;
      transition: opacity .3s;
    }
    body.dark-mode #cs-navigation.scroll-down:before { opacity: 0; }
    body.dark-mode #cs-navigation .cs-logo { filter: grayscale(1) brightness(1000%); }
    body.dark-mode #cs-navigation .cs-li-link { color: var(--bodyTextColorWhite); }
  }
</style>
