---
// Utils
import { Icon } from "astro-icon/components";
import { getCurrentYear } from "@js/utils";

// Data
import { BUSINESS } from "@data/client";
import { SITE } from "@data/client";
import navData from "@data/navData.json";

import logo from "@assets/images/logos/logo-1.png";

const currentYear = getCurrentYear();
---


<!-- ============================================ -->
<!--                  Footer                      -->
<!-- ============================================ -->

<footer id="footer-2395">
    <div class="cs-container">
        <div class="cs-logo-group">
            <a href="" class="cs-logo" aria-label="back to home">
                <img src={logo.src} alt="logo" loading="lazy" decoding="async" width="321" height="56" aria-hidden="true">
            </a>
            <p class="cs-text">
                Temos as melhores soluções em móveis sob medida e totalmente customizados.
            </p>
            <div class="cs-contact-info">
                <span class="cs-header">Contato</span>
                <a href={BUSINESS.phoneForTel} class="cs-contact-link">
                    <img class="cs-icon" src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/phone-w.svg" alt="icon" width="24" height="24" loading="lazy" decoding="async" aria-hidden="true">
                    {BUSINESS.phoneFormatted} 
                </a>
                <a href=mailto:{BUSINESS.email} class="cs-contact-link">
                    <img class="cs-icon" src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/mail-w.svg" alt="icon" width="24" height="24" loading="lazy" decoding="async" aria-hidden="true">
                    {BUSINESS.email}
                </a>
                <a href="" class="cs-contact-link">
                    <img class="cs-icon" src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/pin-w.svg" alt="icon" width="24" height="24" loading="lazy" decoding="async" aria-hidden="true">
                    {BUSINESS.address.lineOne} {BUSINESS.address.lineTwo}
                </a>
            </div>
            <div class="cs-social">
                <!--Get more icons at flaticon.com and download the svg-->
                <a href="" class="cs-social-link" aria-label="visit facebook">
                    <img class="cs-social-icon" src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/face-w.svg" alt="icon" width="12" height="12" loading="lazy" decoding="async" aria-hidden="true">
                </a>
                <a href="" class="cs-social-link" aria-label="visit twitter">
                    <img class="cs-social-icon" src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/x-w.svg" alt="icon" width="12" height="12" loading="lazy" decoding="async" aria-hidden="true">
                </a>
                <a href="" class="cs-social-link" aria-label="visit instagram">
                    <img class="cs-social-icon" src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/insta-w.svg" alt="icon" width="12" height="12" loading="lazy" decoding="async" aria-hidden="true">
                </a>
                <a href="" class="cs-social-link" aria-label="visit youtube">
                    <img class="cs-social-icon" src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Icons/you-w.svg" alt="icon" width="12" height="12" loading="lazy" decoding="async" aria-hidden="true">
                </a>
            </div>
        </div>
        <div class="cs-service-group">
            <span class="cs-header">Serviços</span>
            <ul class="cs-ul">
                <li class="cs-li"><a href="" class="cs-link">Móveis Sob Medida</a></li>
                <li class="cs-li"><a href="" class="cs-link">Móveis para Cozinhas</a></li>
                <li class="cs-li"><a href="" class="cs-link">Móveis para Quartos</a></li>
                <li class="cs-li"><a href="" class="cs-link">Móveis para Salas</a></li>
                <li class="cs-li"><a href="" class="cs-link">Móveis para Banheiros</a></li>
                <li class="cs-li"><a href="" class="cs-link">Armários e Guarda-Roupas</a></li>
                <li class="cs-li"><a href="" class="cs-link">Móveis para Escritórios</a></li>
                <li class="cs-li"><a href="" class="cs-link">Projetos de Marcenaria</a></li>
            </ul>
            <div class="cs-terms">
                <a href="" class="cs-link">Terms & Condition</a>
                <a href="" class="cs-link">Privacy Policy</a>
                <a href="" class="cs-link">Cancellation</a>
            </div>
            <span class="cs-copyright">
                © Copyright {currentYear} - <a href="" class="cs-link">{SITE.author}</a>
            </span>
        </div>
    </div>
    <img class="cs-floater" src="https://csimg.nyc3.cdn.digitaloceanspaces.com/Images/Graphics/flower-svg.svg" alt="flower graphic" loading="lazy" decoding="async" width="635" height="728" aria-hidden="true">
</footer>




<!-- Modificado background-color do footer para var(--backgroundDark) com fallback -->
<!-- Modificado max-width da .cs-container para var(--containerWidth) -->
<!-- Modificado cores dos textos e links secundários para var(--cardMutedTextDark) e var(--bodyTextColorWhite) -->
<!-- Modificado line-height do cabeçalho, links e texto comum para var(--lineHeightHeading) e var(--lineHeightBody) -->
<!-- Modificado hover de links e redes sociais para var(--primary) e var(--primaryDark) -->
<!-- Modificado border-color das divisórias para var(--borderColorLight) com fallback -->
<style lang="less">

/*-- -------------------------- -->
<---          Footer            -->
<--- -------------------------- -*/

/* Mobile */
@media only screen and (min-width: 0rem) {
  #footer-2395 {
    padding: var(--sectionPadding);
    background-color: var(--backgroundDark, #0F172A);
    overflow: hidden;
    position: relative;
    z-index: 1;
  }
  #footer-2395 .cs-container {
    width: 100%;
    /* changes to 1280px at desktop */
    max-width: 36.5rem;
    margin: auto;
    display: flex;
    flex-direction: column;
  }
  #footer-2395 .cs-logo {
    background-color: #fff;
    border-radius: .5rem;
    width: 90%;
    max-width: 20.0625rem;
    height: auto;
    margin-bottom: 1rem;
    display: block;
  }
  #footer-2395 .cs-logo img {
    width: 100%;
    height: auto;
  }
  #footer-2395 .cs-text {
    text-align: inherit;
    /* 32px - 40px */
    margin: 0 0 clamp(2rem, 5vw, 2.5rem);
    color: var(--cardMutedTextDark, rgba(248, 248, 244, 0.72));
    line-height: var(--lineHeightBody, 1.55);
  }
  #footer-2395 .cs-contact-info {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* 8px - 12px */
    gap: clamp(0.5rem, 1.5vw, 0.75rem);
  }
  #footer-2395 .cs-header {
    font-size: 1.25rem;
    line-height: var(--lineHeightHeading, 1.2);
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--bodyTextColorWhite, #FAFBFC);
    display: block;
  }
  #footer-2395 .cs-contact-link {
    font-size: 1rem;
    line-height: var(--lineHeightBody, 1.55);
    text-align: inherit;
    text-decoration: none;
    margin: 0;
    color: var(--cardMutedTextDark, rgba(248, 248, 244, 0.72));
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.3s;
  }
  #footer-2395 .cs-contact-link:hover {
    color: var(--primary, #A36626);
  }
  #footer-2395 .cs-icon {
    width: 1.5rem;
    height: auto;
    display: block;
  }
  #footer-2395 .cs-social {
    /* 24px - 32px */
    margin-top: clamp(1.5rem, 5vw, 2rem);
    display: flex;
    justify-content: flex-start;
    align-items: stretch;
    gap: 0.5rem;
  }
  #footer-2395 .cs-social-link {
    width: 2rem;
    height: 2rem;
    border-radius: var(--avatarRadius, 999px);
    border: 1px solid var(--borderColorLight, rgba(255, 255, 255, 0.16));
    display: flex;
    justify-content: center;
    align-items: center;
    transition: background-color 0.3s, border-color 0.3s;
  }
  #footer-2395 .cs-social-link:hover {
    background-color: var(--primary, #A36626);
    border-color: var(--primary, #A36626);
  }
  #footer-2395 .cs-social-icon {
    width: 0.75rem;
    height: auto;
    display: block;
  }
  #footer-2395 .cs-service-group {
    margin-top: 3rem;
    padding-top: 3rem;
    border-top: 1px solid var(--borderColorLight, rgba(255, 255, 255, 0.16));
    display: flex;
    flex-direction: column;
  }
  #footer-2395 .cs-service-group .cs-header {
    margin-bottom: 1.5rem;
  }
  #footer-2395 .cs-ul {
    margin: 0 0 4rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  #footer-2395 .cs-li {
    list-style: none;
    grid-column: span 2;
  }
  #footer-2395 .cs-link,
  #footer-2395 .cs-copyright {
    font-size: 1rem;
    text-decoration: none;
    line-height: var(--lineHeightBody, 1.55);
    margin: 0;
    color: var(--cardMutedTextDark, rgba(248, 248, 244, 0.72));
    display: block;
  }
  #footer-2395 .cs-link {
    transition: color 0.3s;
  }
  #footer-2395 .cs-link:hover {
    color: var(--primary, #A36626);
  }
  #footer-2395 .cs-terms {
    margin-bottom: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  #footer-2395 .cs-terms .cs-link {
    display: flex;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  #footer-2395 .cs-terms .cs-link:after {
    content: '';
    width: 4px;
    height: 4px;
    margin-left: 1rem;
    background: var(--bodyTextColorWhite, #FAFBFC);
    border-radius: var(--radius-pill, 999px);
    opacity: 1;
    display: block;
  }
  #footer-2395 .cs-terms .cs-link:last-of-type:after {
    display: none;
  }
  #footer-2395 .cs-copyright {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  #footer-2395 .cs-floater {
    /* 500px -635px */
    width: clamp(31.25rem, 50vw, 39.6875rem);
    height: auto;
    filter: blur(180px);
    opacity: 0.44;
    position: absolute;
    bottom: -1.25rem;
    right: -15rem;
    z-index: -2;
  }
}
/* Tablet - 768px */
@media only screen and (min-width: 700px) {
  #footer-2395 .cs-ul {
    column-gap: 4rem;
  }
  #footer-2395 .cs-li {
    grid-column: span 1;
  }
}
/* Small Desktop - 1024px */
@media only screen and (min-width: 64rem) {
  #footer-2395 .cs-container {
    max-width: var(--containerWidth, 78rem);
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    /* 48px - 64px */
    column-gap: clamp(3rem, 3.8vw, 4rem);
  }
  #footer-2395 .cs-logo-group {
    width: 33%;
    max-width: 24.125rem;
    /* prevents flexbox from squishing it */
    flex: none;
  }
  #footer-2395 .cs-service-group {
    width: 100%;
    max-width: 42rem;
    height: auto;
    margin: 0;
    padding-top: 0;
    /* 48px - 64px */
    padding-left: clamp(3rem, 5.8vw, 4rem);
    border: none;
    border-left: 1px solid var(--borderColorLight, rgba(255, 255, 255, 0.16));
  }
  #footer-2395 .cs-terms {
    margin-top: auto;
  }
  #footer-2395 .cs-floater {
    bottom: -13.75rem;
  }
}
/* Large Desktop - 1800px */
@media only screen and (min-width: 1800px) {
  #footer-2395 .cs-floater {
    margin-left: 21.875rem;
    right: auto;
    left: 50%;
  }
}

</style>
