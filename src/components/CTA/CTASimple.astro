---
/**
 * * Simplified CTA component using Astro's built-in Picture component
 **/

// Utils
import { Picture } from "astro:assets";

// Images
import ctaImage from "@assets/images/CTA/cabinets2.jpg";

import { BUSINESS } from "@data/client";
---

<section id="cta">
	<div class="container">
		<h2 class="title">
			Conte com a
			<br />
			{BUSINESS.name}
		</h2>
		<p>Encontre opções em marcenaria para atender às necessidades do seu ambiente. Entre em contato com a Artrenove, apresente sua ideia e converse sobre as possibilidades para o seu projeto.</p>
		<a href="/contact/" class="cs-button cs-button-light">Solicite um Orçamento</a>
	</div>
	<Picture src={ctaImage} alt="" 
             layout="full-width" 
             formats={["avif", "webp"]} 
             pictureAttributes={{ class: "cs-picture" }} 
    />
</section>


<!-- Modificado padding do #cta no mobile/desktop para var(--sectionPadding) -->
<!-- Modificado background do overlay no :before e .cs-picture:before para var(--backgroundDark) com fallback -->
<!-- Modificado line-height e cor do título .title para var(--lineHeightHeading) e var(--bodyTextColorWhite) -->
<!-- Modificado line-height e cor do parágrafo p para var(--lineHeightBody) e var(--bodyTextColorWhite) -->
<!-- Modificado border-radius de imagem em .cs-picture para var(--imageRadius) -->
<style lang="less">
    /* Mobile */
    @media only screen and (min-width: 0em) {
        #cta {
            padding: var(--sectionPadding, (50/16rem) 0);
            position: relative;

            &:before {
                content: "";
                width: 100%;
                height: 100%;
                background-color: var(--backgroundDark, #0F172A);
                opacity: 0.7;
                display: block;
                position: absolute;
                top: 0;
                left: 0;
                z-index: -1;
            }

            .container {
                text-align: center;
                max-width: var(--containerWidth, 78rem);
                margin: auto;
                padding: 0 var(--containerPadding, 1rem);
            }

            .title {
                font-size: ~"min(9vw, 3rem)";
                font-weight: 900;
                line-height: var(--lineHeightHeading, 1.2);
                text-align: center;
                margin-bottom: (36/16rem);
                color: var(--bodyTextColorWhite, #FAFBFC);
                position: relative;
            }

            p {
                text-align: center;
                width: 96%;
                max-width: (598/16rem);
                margin: auto;
                margin-bottom: (36/16rem);
                line-height: var(--lineHeightBody, 1.55);
                color: var(--bodyTextColorWhite, #FAFBFC);
                opacity: 1;
            }

            .cs-picture {
                width: 100%;
                height: 100%;
                object-fit: cover;
                position: absolute;
                top: 0;
                left: 0;
                z-index: -2;
                border-radius: var(--imageRadius, 0.25rem);
                overflow: hidden;

                img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }
            }
        }
    }

    /* Small Desktop */
    @media only screen and (min-width: 64em) {
        #cta {
            padding: var(--sectionPadding, (168/16rem) 0);
        }
    }

    /* Large Desktop */
    @media only screen and (min-width: 1300px) {
        #cta {
            margin-top: (100/16rem);
            position: relative;
            &:before {
                display: none;
            }
            &:after {
                content: "";
                // width: (2000/16rem);
                width: 100%; /* a fixed width causes overflow on desktop */
                height: (1108/16rem);
                background: url("/src/icons/cta-squares.svg");
                background-position: center;
                background-size: contain;
                background-repeat: no-repeat;
                opacity: 1;
                display: block;
                position: absolute;
                bottom: 0;
                left: 50%;
                z-index: -3;
                transform: translateX(-50%);
            }
            .container {
                width: 90.0625%;
                margin: auto;
            }

            .cs-picture {
                width: 90.0625%;
                left: 50%;
                transform: translateX(-50%);
                &:before {
                    content: "";
                    width: 100%;
                    height: 100%;
                    background-color: var(--backgroundDark, #0F172A);
                    opacity: 0.7;
                    display: block;
                    position: absolute;
                    top: 0;
                    left: 0;
                    z-index: 1;
                }
            }
        }
    }

    /* Dark Mode */
    @media only screen and (min-width: 0em) {
        body.dark-mode {
            #cta {
                &:after {
                    display: none;
                }
            }
        }
    }
</style>